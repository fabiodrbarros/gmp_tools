# Copy this file to .env (next to docker-compose.yml) and fill in the values.
# docker compose reads it automatically.

# Public URL of the site (behind Cloudflare this is your domain)
NEXT_PUBLIC_SITE_URL=https://gmptools.pt

# Admin panel (/gmp-panel-admin) credentials — CHANGE THESE
ADMIN_USER=admin
ADMIN_PASSWORD=troca-esta-password
# Random secret for the session cookie. Generate one with:
#   openssl rand -hex 24
ADMIN_TOKEN=cole-aqui-um-segredo-aleatorio-longo

# true = cookie only over HTTPS (recommended behind Cloudflare).
# Set to false only if you test directly over http://IP:3000
COOKIE_SECURE=true

# Set to true for the FIRST boot to load demo products/machines/categories,
# then change back to false and redeploy.
SEED_ON_START=false
