# =============================================================================
# GMP TOOLS — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# --- Database ---
DATABASE_URL="postgresql://gmptools:password@localhost:5432/gmptools"

# --- NextAuth / Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email (Resend) ---
RESEND_API_KEY="re_..."
RESEND_FROM="noreply@gmptools.pt"

# --- Storage (Uploadthing / S3) ---
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# --- WhatsApp ---
NEXT_PUBLIC_WHATSAPP_NUMBER="351910000000"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="GMP Tools"
